    {"key": "Etdy_use1", "name": "Daily Consumption", "unit": "kWh", "reg": ["0x3157", "0x3158"], "scale": 0.001},
    {"key": "Etdy_pu1", "name": "Daily Energy Purchased", "unit": "kWh", "reg": ["0x316B", "0x316C"], "scale": 0.001},
    {"key": "Etdy_cg1", "name": "Daily Charging Energy", "unit": "kWh", "reg": ["0x316D", "0x316E"], "scale": 0.001},
    {"key": "Etdy_dcg1", "name": "Daily Discharging Energy", "unit": "kWh", "reg": ["0x316F", "0x3170"], "scale": 0.001}
