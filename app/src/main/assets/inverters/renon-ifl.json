    {"key": "PG_Pt1", "name": "Total Grid Power", "unit": "W", "reg": ["0x2285", "0x2284"], "signed": true},
    {"key": "B_P1", "name": "Battery Power", "unit": "W", "reg": ["0x314A"], "signed": true},
    {"key": "B_left_cap1", "name": "SoC", "unit": "%", "reg": ["0x3145"], "scale": 0.1},
    {"key": "B_V1", "name": "Battery Voltage", "unit": "V", "reg": ["0x3140"], "scale": 0.1},
    {"key": "B_T1", "name": "Temperature- Battery", "unit": "℃", "reg": ["0x3146"], "signed": true, "scale": 0.1},
    {"key": "AC_T", "name": "AC Temperature", "unit": "℃", "reg": ["0x16A6"], "signed": true, "scale": 0.1},
    {"key": "E_Puse_t1", "name": "Total Consumption Power", "unit": "W", "reg": ["0x2289", "0x2288"]},
    {"key": "Etdy_ge1", "name": "Daily Production", "unit": "kWh", "reg": ["0x3153", "0x3154"], "scale": 0.001},
