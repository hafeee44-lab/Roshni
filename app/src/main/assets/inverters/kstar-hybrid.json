  "notes": "Grid state from inverter status 0x0BE7: 1 off-grid, 2 on-grid, 4 switching to off-grid. KSTAR's grid power is positive while exporting, so the per-phase sum is flipped.",
  "metrics": [
    {"key": "GRID_RELAY_ST1", "name": "Grid Relay Status", "reg": ["0x0BE7"], "text": {"1": "Open", "2": "Closed", "4": "Open"}},
    {"key": "G_V_L1", "name": "Grid Voltage L1", "unit": "V", "reg": ["0x0C19"], "scale": 0.1},
    {"key": "PG_F1", "name": "Grid Frequency", "unit": "Hz", "reg": ["0x0C1A"], "scale": 0.01},
    {"key": "PG_Pt1", "name": "Total Grid Power", "unit": "W", "scale": -1, "sum": [{"reg": ["0x0C1C"], "signed": true}, {"reg": ["0x0C20"], "signed": true}, {"reg": ["0x0C24"], "signed": true}]},
    {"key": "B_P1", "name": "Battery Power", "unit": "W", "reg": ["0x0BF9"], "signed": true},
    {"key": "B_left_cap1", "name": "SoC", "unit": "%", "reg": ["0x0BFA"], "scale": 0.1},
    {"key": "B_V1", "name": "Battery Voltage", "unit": "V", "reg": ["0x0BF7"], "scale": 0.01},
    {"key": "B_T1", "name": "Temperature- Battery", "unit": "℃", "reg": ["0x0BFB"], "signed": true, "scale": 0.1},
    {"key": "S_P_T", "name": "Total Solar Power", "unit": "W", "sum": [{"reg": ["0x0BD0"], "signed": true}, {"reg": ["0x0BD1"], "signed": true}]},
    {"key": "E_Puse_t1", "name": "Total Consumption Power", "unit": "W", "reg": ["0x0C48"]},
    {"key": "Etdy_ge1", "name": "Daily Production", "unit": "kWh", "reg": ["0x0BDC"], "scale": 0.1},
    {"key": "Etdy_pu1", "name": "Daily Energy Purchased", "unit": "kWh", "reg": ["0x0C25"], "scale": 0.1},
    {"key": "Etdy_gn1", "name": "Daily Grid Feed-in", "unit": "kWh", "reg": ["0x0C2C"], "scale": 0.1},
    {"key": "Etdy_use1", "name": "Daily Consumption", "unit": "kWh", "reg": ["0x0C4B"], "scale": 0.1},
    {"key": "Etdy_dcg1", "name": "Daily Discharging Energy", "unit": "kWh", "reg": ["0x0CDE"], "scale": 0.1},
