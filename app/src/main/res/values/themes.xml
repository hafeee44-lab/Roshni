<resources>
    <!-- Compose draws everything; this only sets the window before the first frame. -->
    <style name="Theme.SolarGrid" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.SolarGrid.Alarm" parent="Theme.SolarGrid">
        <item name="android:windowBackground">@color/alarm_window</item>
    </style>
</resources>
